# Copy to .env (gitignored); Bun loads it automatically.
# VS Code binary that `make vscode-e2e` launches; empty uses /Applications/Visual Studio Code.app.
VSCODE_EXECUTABLE=
# Set by vscode-extension/test-electron/run.ts for the test suite inside VS Code; leave empty.
BLEND_REPOSITORY_ROOT=

# Commit shown in the website footer (website/lib/build-info.ts); GitHub Actions sets it, locally git is used.
GITHUB_SHA=
