{
  "name": "blendfile",
  "version": "0.1.0",
  "description": "Read Blender .blend files (legacy and 5.x headers, gzip/zstd, SDNA) in browsers and Node.js.",
  "license": "MIT",
  "author": "Michael Mannseicher <mad.mansi90@gmail.com>",
  "homepage": "https://mansi1.github.io/blendfile/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mansi1/blendfile.git"
  },
  "bugs": {
    "url": "https://github.com/Mansi1/blendfile/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.9",
  "keywords": [
    "blender",
    "blend",
    "sdna",
    "parser",
    "3d"
  ],
  "sideEffects": false,
  "files": [
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.d.mts",
    "dist/*.d.cts",
    "spec",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pkgroll --clean-dist --src src",
    "prepublishOnly": "bun run build && bun run test",
    "test": "bun test test/",
    "lint": "make lint",
    "website:dev": "make dev",
    "website:build": "make website",
    "e2e": "make e2e"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "fzstd": "0.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/three": "0.186.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "defuss": "3.4.9",
    "defuss-shadcn": "0.9.10",
    "defuss-ssg": "0.7.5",
    "defuss-vite": "1.2.1",
    "marked": "18.1.1",
    "oxlint": "1.88.0",
    "pkgroll": "2.28.1",
    "shiki": "4.5.0",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
