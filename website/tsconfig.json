{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "defuss",
    "paths": {
      "blendfile": [
        "../src/index.ts"
      ],
      "blendfile-preview": [
        "../vscode-extension/src/webview/preview-app.tsx"
      ]
    }
  },
  "include": [
    "components",
    "lib",
    "config.ts"
  ]
}
